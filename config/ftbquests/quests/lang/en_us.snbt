	quest.609E0C50662EFBFB.quest_desc: [
		"To obtain &b&nEnergized Crystal&r, you first need to find a &7&nBudding Certus Quartz&r of any quality. Lightning has a chance to convert it into an &b&nBudding Energized Crystal&r of the corresponding quality, and a &6Growth Accelerator&r can speed this up. You will also need something to break the clusters, such as an &8Annihilation Plane&r or a &2Contraption&r."
		""
		"{image:neoecoae:block/energized_crystal_cluster width:16 height:16 align:center}"
	]
